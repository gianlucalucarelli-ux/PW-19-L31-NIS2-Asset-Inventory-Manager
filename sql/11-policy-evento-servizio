-- 11-policy-evento-servizio.sql
-- Descrizione: Policy RLS per tabella evento_servizio.
-- Obiettivo: Permettere agli utenti autenticati di eseguire INSERT e SELECT.

-- Assicura che la RLS sia attiva sulla tabella
ALTER TABLE public.evento_servizio ENABLE ROW LEVEL SECURITY;

-- Rimozione di eventuali policy preesistenti per evitare conflitti
DROP POLICY IF EXISTS "auth_insert_evento_servizio" ON public.evento_servizio;
DROP POLICY IF EXISTS "auth_select_evento_servizio" ON public.evento_servizio;

-- Creazione Policy per l'inserimento
-- Autorizza gli utenti autenticati a creare nuovi record
CREATE POLICY "auth_insert_evento_servizio" 
ON public.evento_servizio 
FOR INSERT 
TO authenticated 
WITH CHECK (true);

-- Creazione Policy per la lettura
-- Autorizza gli utenti autenticati a visualizzare i record
CREATE POLICY "auth_select_evento_servizio" 
ON public.evento_servizio 
FOR SELECT 
TO authenticated 
USING (true);