@startuml
' =========================================================================
' FILE: docs/Diagramma_Repository_SQL.puml
' TARGET ARCHITETTURALE: CORE MIGRATION PIPELINE 01-21
' DESCRIZIONE: Sequenza degli script SQL produttivi del progetto
' NOTA: Codice aggiornato per riprodurre il diagramma inserito nella
'       Relazione_Tecnica_Backend_Database.pdf
' =========================================================================

scale 950 width

title <size:22>CORE MIGRATION PIPELINE (01–21)</size>\n<size:13><color:#607D8B>Evoluzione sequenziale del backend PostgreSQL/Supabase</color></size>

skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 18
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 13
skinparam ArrowColor #78909C
skinparam ArrowThickness 1.4
skinparam linetype spline

skinparam rectangle {
    BorderColor #607D8B
    FontColor #263E52
    FontSize 13
}

top to bottom direction

rectangle "<size:15>FASE 1 — BASELINE E SICUREZZA</size>\n\n01 Schema iniziale\n02 Dataset controllato\n03 RLS\n04 Privilegi e DCL" as F1 #EAF2FB

rectangle "<size:15>FASE 2 — VISTE, AUDIT E TEMPO</size>\n\n05 Viste ACN\n06 Audit asset\n07 Time-zone\n08 Policy di lettura" as F2 #EEF6EE

rectangle "<size:15>FASE 3 — INCIDENTI ACN</size>\n\n09 Strutture tassonomiche\n10 Popolamento tassonomia\n11 Hardening eventi" as F3 #F7F1E5

rectangle "<size:15>FASE 4 — HARDENING E GERARCHIE</size>\n\n12 Vincoli di dominio\n13 Gerarchia servizi\n14 Gerarchia asset" as F4 #F4ECF7

rectangle "<size:15>FASE 5 — FORNITORI E RELAZIONI</size>\n\n15 Gerarchia fornitori\n16 Relazione asset–fornitore" as F5 #EEF3F3

rectangle "<size:15>FASE 6 — SUPPLY CHAIN E AUDIT</size>\n\n17 Viste multilivello\n18 Reporting corretto\n19 Audit generalizzato" as F6 #F8ECEC

rectangle "<size:15>FASE 7 — CONSERVAZIONE E CHIUSURA</size>\n\n20 Archiviazione logica e blocco DELETE   •   21 Eliminazione dell’ultimo ON DELETE CASCADE" as F7 #EEF2F6

' -------------------------------------------------------------------------
' Allineamento delle tre righe
' -------------------------------------------------------------------------

F1 -[hidden]right-> F2
F2 -[hidden]right-> F3

F4 -[hidden]right-> F5
F5 -[hidden]right-> F6

F1 -[hidden]down-> F4
F2 -[hidden]down-> F5
F3 -[hidden]down-> F6

F5 -[hidden]down-> F7

' -------------------------------------------------------------------------
' Collegamenti visibili, coerenti con il diagramma della relazione
' -------------------------------------------------------------------------

F1 -right-> F2
F2 -right-> F3

F1 -down-> F4

F4 -right-> F5
F5 -right-> F6

F6 -down-> F7

caption <size:11><color:#78909C>Risultato verificato: 30 tabelle, 7 viste principali, sicurezza RLS, audit generalizzato e conservazione logica.</color></size>

@enduml
