@startuml
' =========================================================================
' FILE: docs/Diagramma_Navigazione_Frontend.puml
' TARGET ARCHITETTURALE: NAVIGAZIONE FRONTEND NIS2 ASSET INVENTORY MANAGER
' DESCRIZIONE:
' - Mappa ufficiale della navigazione pubblica e autenticata
' - Accesso unico con MFA dinamica in base all'utente e al livello AAL
' - Struttura responsive per desktop, tablet e dispositivi mobili
' - Riferimento per sviluppo, relazione tecnica frontend e Project Work
' =========================================================================

title <size:22>ARCHITETTURA DI NAVIGAZIONE FRONTEND</size>\n<size:13><color:#607D8B>NIS2 Asset Inventory Manager — Home pubblica, autenticazione e area applicativa</color></size>

skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 16
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam ArrowColor #607D8B
skinparam ArrowThickness 1.4
skinparam packageStyle rectangle
skinparam linetype ortho

skinparam rectangle {
    BorderColor #607D8B
    FontColor #263238
}

skinparam package {
    BorderColor #607D8B
    FontColor #263238
}

top to bottom direction

package "AREA PUBBLICA" #E3F2FD {
    rectangle "HOME PUBBLICA\n\n• Presentazione del progetto\n• Funzionalità principali\n• Sicurezza e conformità\n• Lingua IT / EN\n• Tema chiaro / scuro\n• Logo e identità visiva" as HOME #EAF2FB

    rectangle "ACCESSO RISERVATO\n\n• E-mail\n• Password\n• Mostra / nascondi password\n• Messaggi di errore\n• Stato di caricamento" as LOGIN #EAF2FB

    HOME -right-> LOGIN
}

package "AUTENTICAZIONE E SESSIONE" #FFF8E1 {
    rectangle "AUTENTICAZIONE SUPABASE\n\nVerifica credenziali e recupero sessione" as AUTH #FFF8E1

    rectangle "VERIFICA IDENTITÀ E AAL\n\n• Utente autenticato\n• Fattori MFA disponibili\n• Livello AAL corrente\n• Livello AAL raggiungibile" as AAL #FFF8E1

    rectangle "ACCESSO DIRETTO\n\nUtente autorizzato\nsenza secondo fattore" as DIRECT #F1F8E9

    rectangle "VERIFICA MFA\n\nInserimento codice TOTP\nper gli utenti soggetti a MFA" as MFA #FFF3E0

    LOGIN -down-> AUTH
    AUTH -down-> AAL
    AAL -left-> DIRECT : MFA non richiesta
    AAL -right-> MFA : MFA richiesta
}

package "AREA APPLICATIVA AUTENTICATA" #E8F5E9 {
    rectangle "LAYOUT APPLICATIVO\n\nBarra superiore\n• Logo e nome applicazione\n• Breadcrumb\n• IT / EN\n• Tema chiaro / scuro\n• Utente collegato\n• Stato MFA / AAL\n• Logout\n\nNavigazione laterale responsive\n• Desktop: estesa\n• Tablet: comprimibile\n• Mobile: menu apribile" as SHELL #E8F5E9

    rectangle "DASHBOARD\n\n• Indicatori principali\n• Asset e servizi critici\n• Fornitori\n• Incidenti recenti\n• Ultime attività di audit\n• Stato Supply Chain\n• Azioni rapide" as DASHBOARD #E8F5E9

    DIRECT -down-> SHELL
    MFA -down-> SHELL
    SHELL -down-> DASHBOARD
}

package "INVENTARIO" #E3F2FD {
    rectangle "ASSET\n\n• Elenco e filtri\n• Dettaglio\n• Inserimento\n• Modifica\n• Relazioni\n• Audit del record\n• Archiviazione" as ASSET #EAF2FB

    rectangle "SERVIZI\n\n• Elenco e filtri\n• Dettaglio\n• Inserimento\n• Dipendenze\n• Sottoservizi\n• Archiviazione" as SERVICE #EAF2FB

    rectangle "FORNITORI\n\n• Elenco e filtri\n• Dettaglio\n• Inserimento\n• Asset e servizi collegati\n• Subfornitori\n• Archiviazione" as SUPPLIER #EAF2FB

    rectangle "VULNERABILITÀ\n\n• Elenco e filtri\n• Asset interessati\n• Severità\n• Stato remediation" as VULN #EAF2FB
}

package "RELAZIONI" #F3E5F5 {
    rectangle "SUPPLY CHAIN\n\n• Vista tabellare\n• Vista gerarchica\n• Dipendenze dirette\n• Dipendenze derivate\n• Percorso multilivello" as CHAIN #F4ECF7

    rectangle "GERARCHIA SERVIZI\n\nServizi e sottoservizi" as H_SERVICE #F4ECF7
    rectangle "GERARCHIA ASSET\n\nAsset e sotto-asset" as H_ASSET #F4ECF7
    rectangle "GERARCHIA FORNITORI\n\nFornitori e subfornitori" as H_SUPPLIER #F4ECF7
}

package "SICUREZZA E CONFORMITÀ" #FFEBEE {
    rectangle "GESTIONE INCIDENTI\n\n• Elenco incidenti\n• Nuova segnalazione\n• Bozze\n• Wizard ACN\n• Riepilogo e report" as INCIDENT #F8ECEC

    rectangle "AUDIT\n\n• Elenco filtrabile\n• Dettaglio operazione\n• Stato precedente\n• Stato successivo\n• Utente e livello AAL" as AUDIT #F8ECEC
}

package "OPERAZIONI" #FFF3E0 {
    rectangle "IMPORTAZIONE MASSIVA\n\n• Asset\n• Servizi\n• Fornitori\n• Relazioni\n• Anteprima e validazione\n• Rapporto errori" as IMPORT #F7F1E5

    rectangle "ESPORTAZIONE\n\n• Dati filtrati\n• XLSX / CSV\n• Modelli di importazione" as EXPORT #F7F1E5

    rectangle "ARCHIVIO\n\n• Entità archiviate\n• Relazioni scadute\n• Motivazioni e date" as ARCHIVE #F7F1E5
}

package "SUPPORTO" #ECEFF1 {
    rectangle "INFORMAZIONI E GUIDA\n\n• Finalità applicazione\n• Guida rapida\n• Architettura\n• Documentazione tecnica\n• Informazioni sul Project Work" as HELP #EEF2F6
}

DASHBOARD -down-> ASSET
DASHBOARD -down-> SERVICE
DASHBOARD -down-> SUPPLIER
DASHBOARD -down-> VULN
DASHBOARD -down-> CHAIN
DASHBOARD -down-> INCIDENT
DASHBOARD -down-> AUDIT
DASHBOARD -down-> IMPORT
DASHBOARD -down-> HELP

ASSET -right-> SERVICE
SERVICE -right-> SUPPLIER
SUPPLIER -right-> VULN

CHAIN -right-> H_SERVICE
H_SERVICE -right-> H_ASSET
H_ASSET -right-> H_SUPPLIER

INCIDENT -right-> AUDIT

IMPORT -right-> EXPORT
EXPORT -right-> ARCHIVE

note bottom of HELP
  Comportamento responsive:
  - desktop: navigazione laterale estesa;
  - tablet: navigazione comprimibile;
  - smartphone: menu apribile, filtri in pannello,
    tabelle trasformabili in schede e azioni a larghezza completa.
end note

legend bottom
  |= Colore |= Area |
  |<#EAF2FB> | Area pubblica e inventario |
  |<#FFF8E1> | Autenticazione e sessione |
  |<#E8F5E9> | Layout applicativo e Dashboard |
  |<#F4ECF7> | Relazioni e gerarchie |
  |<#F8ECEC> | Sicurezza, incidenti e audit |
  |<#F7F1E5> | Operazioni massive e archivio |
  |<#EEF2F6> | Informazioni e supporto |
endlegend

@enduml
