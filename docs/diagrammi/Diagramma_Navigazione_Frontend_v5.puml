@startuml
' =========================================================================
' FILE: docs/diagrammi/Diagramma_Navigazione_Frontend_v5.puml
' TARGET ARCHITETTURALE: FRONTEND V5 - BUILD FINALE CON ASSESSMENT FNCSDP
' DESCRIZIONE: Architettura di navigazione del NIS2 Asset Inventory Manager,
'              dalla home pubblica ai moduli operativi, Assessment FNCSDP,
'              Audit Log, supporto e ringraziamenti.
' =========================================================================

scale 1800 width

title <size:22>ARCHITETTURA DI NAVIGAZIONE FRONTEND - V5</size>\n<size:13><color:#455A64>NIS2 Asset Inventory Manager - build finale con Assessment FNCSDP</color></size>

skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 14
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #607D8B
skinparam ArrowThickness 1.3
skinparam linetype polyline
skinparam packageStyle rectangle

skinparam rectangle {
  BorderColor #78909C
  FontColor #212121
}

top to bottom direction

' =========================
' ACCESSO E AREA APPLICATIVA
' =========================
rectangle "HOME PUBBLICA\nPresentazione, logo, accesso, tema e lingua" as HOME #DCEBF7

rectangle "AUTENTICAZIONE SUPABASE\nCredenziali, sessione, MFA/AAL2\ne accesso docente controllato" as AUTH #FFF0C2

rectangle "AREA APPLICATIVA\nHeader, breadcrumb, menu verticale\ne navigazione hash" as APP #DDEFE4

rectangle "DASHBOARD\nIndicatori, criticita, Supply Chain,\nincidenti e audit" as DASHBOARD #DDEFE4

HOME -down-> AUTH
AUTH -down-> APP
APP -down-> DASHBOARD

' =========================
' MODULI DEL MENU VERTICALE
' =========================
rectangle "AZIENDA\nSoggetti NIS2\nNuovo soggetto\nPersone e figure NIS2\nSoggetti archiviati" as AZIENDA #DCEBF7

rectangle "INVENTARIO\nInventario Asset\nNuovo Asset\nAsset archiviati" as INVENTARIO #DCEBF7

rectangle "SERVIZI\nElenco servizi\nNuovo servizio\nServizi cessati" as SERVIZI #EEE3F6

rectangle "FORNITORI\nElenco fornitori\nNuovo fornitore\nFornitori cessati" as FORNITORI #EEE3F6

rectangle "RELAZIONI\nSupply Chain\nCostruzione dipendenze" as RELAZIONI #EEE3F6

rectangle "INCIDENTI\nIncidenti aperti\nIncidenti chiusi\nNuova segnalazione" as INCIDENTI #F8DCDC

rectangle "SICUREZZA\nAssessment FNCSDP\nAudit Log" as SICUREZZA #F7E8C9

rectangle "SUPPORTO\nInformazioni e guida" as SUPPORTO #E8EEF3

rectangle "RINGRAZIAMENTI\nUniversita, famiglia\ne Maestro del Tai Chi" as RINGRAZIAMENTI #F3E5F5

AZIENDA -[hidden]right-> INVENTARIO
INVENTARIO -[hidden]right-> SERVIZI
SERVIZI -[hidden]right-> FORNITORI
FORNITORI -[hidden]right-> RELAZIONI
RELAZIONI -[hidden]right-> INCIDENTI
INCIDENTI -[hidden]right-> SICUREZZA
SICUREZZA -[hidden]right-> SUPPORTO
SUPPORTO -[hidden]right-> RINGRAZIAMENTI

DASHBOARD -down-> AZIENDA
DASHBOARD -down-> INVENTARIO
DASHBOARD -down-> SERVIZI
DASHBOARD -down-> FORNITORI
DASHBOARD -down-> RELAZIONI
DASHBOARD -down-> INCIDENTI
DASHBOARD -down-> SICUREZZA
DASHBOARD -down-> SUPPORTO
DASHBOARD -down-> RINGRAZIAMENTI

' =========================
' SICUREZZA E VALUTAZIONE
' =========================
rectangle "ASSESSMENT FNCSDP\n1. Profilo Target\n2. Misura / Profilo Attuale\n3. Valutazione: score e gap\n4. Export XLSX\n5. Audit automatico" as ASSESSMENT #FFD18A

rectangle "AUDIT LOG\nFiltri, dettaglio JSON ed export\nRicerca PT, ASS e tabelle FNCSDP" as AUDIT #F7C5C5

SICUREZZA -down-> ASSESSMENT
SICUREZZA -down-> AUDIT
ASSESSMENT -down-> AUDIT : tracciamento

footer NIS2 Asset Inventory Manager - architettura frontend finale V5

@enduml
