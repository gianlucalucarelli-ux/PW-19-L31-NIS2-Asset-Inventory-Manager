@startuml
' =========================================================================
' FILE: docs/diagrammi/Diagnostic_Validation_Patch_Toolkit_X1-X19.puml
' TARGET ARCHITETTURALE: DIAGNOSTIC, VALIDATION & PATCH TOOLKIT X1-X19
' DESCRIZIONE: Classificazione consolidata degli script diagnostici
' =========================================================================

scale 1400 width

title <size:21>DIAGNOSTIC, VALIDATION & PATCH TOOLKIT (X1-X19)</size>\n<size:13><color:#607D8B>Controlli progressivi sul database live, readiness, sicurezza e qualita dei dati</color></size>

skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 18
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 13
skinparam ArrowColor #78909C
skinparam ArrowThickness 1.4
skinparam linetype ortho

skinparam rectangle {
    BorderColor #607D8B
    FontColor #263E52
    FontSize 13
}

top to bottom direction

rectangle "<size:15>ISPEZIONE STRUTTURALE E SICUREZZA</size>\n\nX1 schema e colonne\nX2 colonne delle viste\nX6 trigger e funzioni\nX7 vincoli\nX9 viste e privilegi\nX10 policy RLS e grant" as A #EAF2FB

rectangle "<size:15>BONIFICA E PROTOTIPAZIONE CONTROLLATA</size>\n\nX3 allineamento servizi\nX4 dataset Supply Chain\nX5 prototipo audit JSON" as B #F7F1E5

rectangle "<size:15>READINESS DEL MODELLO</size>\n\nX8 duplicati e organizzazioni\nX11-X12 readiness fornitori\ne relazione asset-fornitore\nX13 Supply Chain multilivello" as C #EEF6EE

rectangle "<size:15>VALIDAZIONE DEL BACKEND</size>\n\nX14 reporting servizi critici\nX15 sistema di audit\nX16 archiviazione logica\nX17 verifica finale backend" as D #F4ECF7

rectangle "<size:15>ACCESSI, MFA E UTENZE DI VALUTAZIONE</size>\n\nX18 diagnostica globale accessi\nVerifica AAL1/AAL2, MFA, anon,\nDELETE e utenze docente" as E #FCE4EC

rectangle "<size:15>QUALITA E NORMALIZZAZIONE DEI DATI</size>\n\nX19 inventario anomalie\nAsset dimostrativi, riferimenti settoriali,\neventi incompleti e dati da normalizzare" as F #FFF8E1

' -------------------------------------------------------------------------
' Allineamento 2 x 3
' -------------------------------------------------------------------------
A -[hidden]right-> B
C -[hidden]right-> D
E -[hidden]right-> F
A -[hidden]down-> C
B -[hidden]down-> D
C -[hidden]down-> E
D -[hidden]down-> F

' -------------------------------------------------------------------------
' Collegamenti visibili
' -------------------------------------------------------------------------
A -right-> B
A -down-> C
B -down-> D
C -right-> D
D -down-> E
E -right-> F

caption <size:11><color:#263E52>Esiti consolidati: X17 = VERIFICA_FINALE_BACKEND_SUPERATA; X18 valida il modello MFA e l'accesso controllato; X19 guida le migrazioni di normalizzazione 24-26.</color></size>\n<size:10><color:#78909C>Il toolkit conserva la distinzione tra diagnostiche, readiness, validazione finale e controlli sulla qualita dei dati.</color></size>

@enduml
